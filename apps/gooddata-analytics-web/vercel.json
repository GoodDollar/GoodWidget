{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "devCommand": "pnpm dev",
  "git": {
    "deploymentEnabled": false
  },
  "rewrites": [
    {
      "source": "/gbmetrics/reports",
      "destination": "https://gbmetrics.gooddollar.org/reports"
    },
    {
      "source": "/gbmetrics/getReport",
      "destination": "https://gbmetrics.gooddollar.org/getReport"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}

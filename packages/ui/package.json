{
  "name": "@goodwidget/ui",
  "version": "0.1.3",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "react-native": {
        "import": "./dist/index.js",
        "require": "./dist/index.cjs"
      },
      "browser": {
        "import": "./dist/web.js",
        "require": "./dist/web.cjs"
      },
      "node": {
        "import": "./dist/web.js",
        "require": "./dist/web.cjs"
      },
      "import": "./dist/web.js",
      "require": "./dist/web.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint src/",
    "clean": "rm -rf dist .turbo",
    "bump-version": "pnpm version patch --no-git-tag-version && git add package.json && git commit -m \"chore(release): bump @goodwidget/ui to $(node -p 'JSON.parse(require(\"fs\").readFileSync(\"package.json\")).version')\""
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-native": ">=0.76.0",
    "react-native-svg": ">=12",
    "@react-native-clipboard/clipboard": ">=1.14.0"
  },
  "peerDependenciesMeta": {
    "react-native": {
      "optional": true
    },
    "react-native-svg": {
      "optional": true
    },
    "@react-native-clipboard/clipboard": {
      "optional": true
    }
  },
  "dependencies": {
    "@tamagui/animations-react-native": "^1.121.0",
    "@tamagui/core": "1.121.0",
    "@tamagui/lucide-icons": "1.121.0",
    "@tamagui/themes": "1.121.0",
    "tamagui": "1.121.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "react": "^18.3.0",
    "react-native": "0.76.9",
    "react-native-web": "^0.19.13",
    "tsup": "^8.4.0",
    "typescript": "^5.7.0"
  }
}

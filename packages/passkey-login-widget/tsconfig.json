{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    // Editor/typecheck config only; emitting is tsup's job via tsconfig.build.json.
    "noEmit": true,
    // Logic modules import each other with explicit .ts so `node --test --experimental-strip-types` can run them.
    "allowImportingTsExtensions": true,
    "types": ["node"],
    "paths": {
      "@goodwidget/core": ["../core/src/index.ts"],
      "@goodwidget/core/*": ["../core/src/*"],
      "@goodwidget/ui": ["../ui/src/index.ts"],
      "react-native": ["./node_modules/react-native-web"]
    }
  },
  "include": ["src", "package.json"]
}
